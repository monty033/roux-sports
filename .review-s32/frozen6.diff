++++   178	            axis = "horizontally"
++++   179	        }
++++   180	
++++   181	        horizontalOverlap > 0f -> {
++++   182	            gap = maxOf(b.top - a.bottom, a.top - b.bottom)
++++   183	            axis = "vertically"
++++   184	        }
++++   185	
++++   186	        else -> {
