++++        rule.setContent {
++++            Box(Modifier.fillMaxSize()) {
++++                Box(
++++                    Modifier
++++                        .align(Alignment.TopStart)
++++                        .padding(start = 16.dp, top = 554.dp)
++++                        .size(width = 200.dp, height = 56.dp)
++++                        .primaryControl("scores.dateStrip", frequent = true),
++++                )
++++            }
++++        }
++++
++++        assertSaw("scores.dateStrip")
