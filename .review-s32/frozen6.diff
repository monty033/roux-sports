+++                    left = left,
+++                    top = top,
+++                    right = left + node.size.width / scale,
+++                    bottom = top + node.size.height / scale,
+++                    primary = tag != null,
+++                    frequent = node.config.getOrNull(IsFrequentControl) ?: false,
+++                    path = path,
+++                )
