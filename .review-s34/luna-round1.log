    10	/*
    11	 * The Compose-side half of the reach audit: read where the targets landed, then ask [Reach].
    12	 *
    13	 * This file is thin on purpose. Everything that decides pass or fail is in [findReachViolations] and is
    14	 * covered without Compose; the only thing this adds is a tree walk and a px-to-dp conversion. If a
    15	 * reach bug is ever about the *rule*, it is not in here.
    16	 */
    17	
    18	/**
    19	 * Audits every reachable target on screen and insists the tree matches the primaries the screen declares.
    20	 *
    21	 * The declaration is also the audit's limit. It can prove the tree matches what a screen says it intends,
    22	 * not that the intent is right: an action wrongly declared non-primary - a reachTarget instead of a
    23	 * primaryControl - sits outside R1, R2 and the edge rules, and nothing here can tell. Reviewing the
    24	 * declaration is part of reviewing the screen.
    25	 */
    26	fun ComposeTestRule.assertPrimaryControlsReachable(vararg expectedPrimaryTags: String) {
    27	    val targets = reachTargets()
    28	    // The screen states its primary controls, and the audit insists the tree agrees. A count guard only
    29	    // catches losing every tag; a screen with two primary actions would still lose one of them silently,
    30	    // and that action would keep its size check while losing R1, R2 and the edge insets. An empty list is
    31	    // a positive statement that this screen has no primary controls.
    32	    val actual = targets.filter { it.primary }.map { it.tag }
    33	    val expected = expectedPrimaryTags.toList()
    34	
    35	    // A tag has to name exactly one control. Compared as sets, two controls sharing a tag would mask one
    36	    // of them losing its tag: the survivor keeps the set equal to the declaration while the other quietly
    37	    // drops out of R1 and R2. Duplicates are rejected outright instead of being collapsed.
    38	    fun duplicates(tags: List<String>): Set<String> =
    39	        tags
    40	            .groupingBy { it }
    41	            .eachCount()
    42	            .filterValues { it > 1 }
    43	            .keys
    44	
    45	    val duplicated = duplicates(actual) + duplicates(expected)
    46	    if (duplicated.isNotEmpty()) {
    47	        throw AssertionError(
    48	            "primary tags must be unique, but ${duplicated.sorted()} appear more than once - " +
    49	                "a shared tag hides one control losing it",
    50	        )
    51	    }
    52	
    53	    if (actual.sorted() != expected.sorted()) {
    54	        throw AssertionError(
    55	            "primary controls are ${actual.sorted()} but the screen declares ${expected.sorted()} - " +
    56	                "an untagged or reachTarget-declared action is outside R1, R2 and the edge rules",
    57	        )
    58	    }
    59	    val violations = reachViolations(targets)
    60	    if (violations.isNotEmpty()) {
    61	        throw AssertionError(
    62	            buildString {
    63	                append("${violations.size} reach violation(s) at ${density.density} density:\n")
    64	                violations.forEach { append("  - ${it.describe()}\n") }
    65	            }.trimEnd(),
    66	        )
    67	    }
    68	}
