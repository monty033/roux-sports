++                    rawTop = top,
++                    rawRight = right,
++                    rawBottom = bottom,
++                    visibleLeft = visibleLeft,
++                    visibleTop = visibleTop,
++                    visibleRight = visibleRight,
++                    visibleBottom = visibleBottom,
++                    primary = primaryTag != null,
++                    frequent = node.config.getOrNull(IsFrequentControl) ?: false,
++                    path = path,
