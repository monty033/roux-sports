<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="game_row_final">FINAL</string>
    <!-- Complete labels let translators choose the separator and word order. -->
    <string name="game_row_final_ot">FINAL · OT</string>
    <string name="game_row_final_so">FINAL · SO</string>
    <string name="game_row_period_first">1st</string>
    <string name="game_row_period_second">2nd</string>
    <string name="game_row_period_third">3rd</string>
    <!-- OT and SO describe the period type; repeated playoff overtime still reads OT. -->
    <string name="game_row_period_overtime">OT</string>
    <string name="game_row_period_shootout">SO</string>
    <string name="game_row_period_unavailable">Period unavailable</string>
    <string name="game_row_intermission">Intermission</string>
    <!-- Football counts quarters, not ordinals: "Q2" is the label a viewer reads, "2nd" is a hockey period. -->
    <string name="game_row_football_quarter">Q%1$d</string>
    <string name="game_row_down_first">1st</string>
    <string name="game_row_down_second">2nd</string>
    <string name="game_row_down_third">3rd</string>
    <string name="game_row_down_fourth">4th</string>
    <!-- The snap, as the rail states it: who has the ball, then the down and what it needs. -->
    <string name="game_row_snap">%1$s · %2$s</string>
    <string name="game_row_snap_distance">%1$s &amp; %2$d</string>
    <string name="game_row_snap_goal">%1$s &amp; goal</string>
    <!-- One spoken clause for the card's sentence, so a screen reader says the down once. -->
    <string name="game_row_description_snap">%1$s has the ball, %2$s</string>
    <string name="game_row_description_red_zone">in the red zone</string>
    <string name="game_row_live_description">Live</string>
    <!-- The rail label is drawn uppercase in final/scores-screen.html; the description stays sentence case. -->
    <string name="game_row_live_label">LIVE</string>
    <string name="game_row_time_tbd">Time TBD</string>
    <string name="game_row_status_unavailable">Status unavailable</string>
    <!-- Paired away/home statistics with an invariant abbreviation, not one inflected quantity. -->
    <!-- One spoken sentence per card: who played, the score, then the state. Translators own the order. -->
    <string name="game_row_description">%1$s, %2$s</string>
    <string name="game_row_description_score">%1$s %2$d, %3$s %4$d</string>
    <string name="game_row_description_upcoming">%1$s at %2$s</string>
    <string name="game_row_description_period">%1$s period</string>
    <string name="game_row_description_final">final</string>
    <string name="game_row_description_final_ot">final in overtime</string>
    <string name="game_row_description_final_so">final in a shootout</string>
    <string name="game_row_description_unknown">status unavailable</string>
    <!-- The accent stripe is a visual cue, so the sentence carries it too. The visible text is unchanged. -->
    <string name="game_row_description_favourite">Favorite matchup. %1$s</string>
</resources>
