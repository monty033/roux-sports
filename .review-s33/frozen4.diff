+++    bannedCalls.forEach { (call, why) ->
+++        var index = code.indexOf(call)
+++        while (index >= 0) {
+++            violations += HiddenActionViolation(lineAt(code, index), "$call is $why")
+++            index = code.indexOf(call, index + call.length)
