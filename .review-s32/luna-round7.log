+++        assertSaw("scores.dateStrip", "scores.toggle")
+++        rule.assertPrimaryControlsReachable()
+++    }
+++
+++    @Test
+++    @Config(qualifiers = "w360dp-h780dp-420dpi")
+++    fun aCompliantLayoutPassesOnASmallPhone() {
+++        rule.setContent {
