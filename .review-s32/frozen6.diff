+++                    ReachViolation(
+++                        ReachRule.R4_SIZE,
+++                        control.tag,
+++                        "is ${fmt(control.width)} x ${fmt(control.height)} dp, under the " +
+++                            "${fmt(Reach.MIN_TARGET_DP)} dp minimum",
