     2	
     3	import androidx.compose.ui.Modifier
     4	import androidx.compose.ui.semantics.SemanticsPropertyKey
     5	import androidx.compose.ui.semantics.SemanticsPropertyReceiver
     6	import androidx.compose.ui.semantics.semantics
     7	
     8	/**
     9	 * The one-handed reach rules (A8, R1-R5), as numbers and as a pure check.
    10	 *
    11	 * The rules are fractions of window height rather than absolute offsets, so they hold on a 6.1" phone
    12	 * and on the Pixel 9 alike. Nothing here measures anything: a caller hands in where each target
    13	 * actually landed, and this decides pass or fail. That keeps the policy testable without Compose and
    14	 * keeps the Compose-side reader thin enough to be obvious.
    15	 *
    16	 * R4 is not conditional on tagging. Tagging marks a control as primary, which *additionally* subjects
    17	 * it to R1, R2 and R5; it is not the price of admission to the size and gap rules. An untagged 40 dp
    18	 * icon is still a 40 dp target, so a screen with no primary controls whatsoever can still fail R4.
    19	 */
    20	object Reach {
    21	    /** R1: a primary control's top edge must be at or below this fraction of window height. */
    22	    const val PRIMARY_TOP_MAX_FRACTION = 0.50f
    23	
    24	    /** R2: a frequent control's top edge must be at or below this fraction of window height. */
    25	    const val FREQUENT_TOP_MAX_FRACTION = 0.70f
    26	
    27	    /** R4: no target smaller than this in either dimension. */
    28	    const val MIN_TARGET_DP = 48f
    29	
    30	    /** R4: a primary control is bigger than the minimum - it is the thing a thumb must hit. */
    31	    const val PRIMARY_MIN_HEIGHT_DP = 56f
    32	
    33	    /** R4: edge-to-edge clearance between adjacent targets. */
    34	    const val MIN_TARGET_GAP_DP = 8f
    35	
    36	    /** R5: no primary control this close to the left or right edge (thumb arc, back gesture). */
    37	    const val EDGE_INSET_DP = 16f
    38	}
    39	
    40	/** Which rule a violation belongs to, so a failure can be read without decoding prose. */
    41	enum class ReachRule(
    42	    val id: String,
    43	) {
    44	    R1("R1 reach zone"),
    45	    R2("R2 frequent controls"),
    46	    R4_SIZE("R4 target size"),
    47	    R4_GAP("R4 target gap"),
    48	    R5_EDGES("R5 edges"),
    49	    R5_CONTAINMENT("R5 containment"),
    50	}
    51	
    52	/**
    53	 * Where one target ended up, in dp.
    54	 *
    55	 * Two rectangles, because they answer different questions. The raw rectangle is where the control was
    56	 * laid out; the visible one is the part inside the window. Size and clearance are judged on what a thumb
    57	 * can actually hit, so a 56 dp button hanging 20 dp off the left edge is a 36 dp target however large
    58	 * its layout size is. Position rules (R1, R2, the edge insets) use the raw rectangle, because a control
    59	 * that starts above the reach line does not become reachable by being clipped.
    60	 *
    61	 * [path] is the node's position in the semantics tree ("0/2/1"), so an ancestor and the thing inside it
    62	 * are not reported as overlapping: a clickable row with a clickable star is two legitimate targets.
    63	 */
    64	data class ControlPlacement(
    65	    val tag: String,
    66	    val rawLeft: Float,
    67	    val rawTop: Float,
    68	    val rawRight: Float,
    69	    val rawBottom: Float,
    70	    val visibleLeft: Float,
    71	    val visibleTop: Float,
    72	    val visibleRight: Float,
    73	    val visibleBottom: Float,
    74	    val primary: Boolean = false,
    75	    val frequent: Boolean = false,
    76	    val path: String = "",
    77	) {
    78	    /** What a thumb can actually press: the part of the target inside the window. */
    79	    val width: Float get() = visibleRight - visibleLeft
    80	    val height: Float get() = visibleBottom - visibleTop
    81	
    82	    val isVisible: Boolean get() = width > 0f && height > 0f
    83	}
    84	
    85	/** A single failed rule, with the measurement that failed it. */
    86	data class ReachViolation(
    87	    val rule: ReachRule,
    88	    val tag: String,
    89	    val detail: String,
    90	) {
    91	    fun describe(): String = "${rule.id}: '$tag' $detail"
    92	}
    93	
    94	/**
    95	 * Every way [controls] breaks R1-R5 in a window of this size.
    96	 *
    97	 * An empty list means the layout is reachable. Violations are returned rather than thrown so a caller
    98	 * can report all of them at once - one failing control usually means several, and fixing them one
    99	 * test-failure at a time is how a reach audit gets abandoned halfway.
   100	 *
   101	 * Known limit: this only sees what was composed. A row a `LazyColumn` has not scrolled into view is not
   102	 * measured, so an audit of an initial viewport can clear only the part it saw, never the whole list.
   103	 * Callers auditing a list must scroll it and audit again.
   104	 */
   105	fun findReachViolations(
   106	    controls: List<ControlPlacement>,
   107	    windowWidthDp: Float,
   108	    windowHeightDp: Float,
   109	): List<ReachViolation> =
   110	    buildList {
   111	        val primaryTopLimit = windowHeightDp * Reach.PRIMARY_TOP_MAX_FRACTION
   112	        val frequentTopLimit = windowHeightDp * Reach.FREQUENT_TOP_MAX_FRACTION
   113	
   114	        for (control in controls) {
   115	            // A composed node scrolled entirely out of view is not on screen to be pressed, so it is not
   116	            // a violation - judging it would fail an audit of a screen nobody can see.
   117	            if (!control.isVisible) continue
   118	            if (control.primary && control.rawTop < primaryTopLimit) {
   119	                add(
   120	                    ReachViolation(
   121	                        ReachRule.R1,
   122	                        control.tag,
   123	                        "starts at ${fmt(control.rawTop)} dp, above the ${fmt(primaryTopLimit)} dp limit " +
   124	                            "(0.50 of ${fmt(windowHeightDp)} dp)",
   125	                    ),
   126	                )
   127	            }
   128	            // R2 is an additional ceiling for frequent controls, not a replacement for R1: a frequent
   129	            // control in the top third passes nothing, and one between 0.50 and 0.70 fails only R2.
   130	            if (control.primary && control.frequent && control.rawTop < frequentTopLimit) {
   131	                add(
   132	                    ReachViolation(
   133	                        ReachRule.R2,
   134	                        control.tag,
   135	                        "is frequent but starts at ${fmt(control.rawTop)} dp, above the " +
   136	                            "${fmt(frequentTopLimit)} dp limit (0.70 of ${fmt(windowHeightDp)} dp)",
   137	                    ),
   138	                )
   139	            }
   140	            if (control.width < Reach.MIN_TARGET_DP || control.height < Reach.MIN_TARGET_DP) {
   141	                add(
   142	                    ReachViolation(
   143	                        ReachRule.R4_SIZE,
   144	                        control.tag,
   145	                        "is ${fmt(control.width)} x ${fmt(control.height)} dp, under the " +
   146	                            "${fmt(Reach.MIN_TARGET_DP)} dp minimum",
   147	                    ),
   148	                )
   149	            }
   150	            if (control.primary && control.height < Reach.PRIMARY_MIN_HEIGHT_DP) {
   151	                add(
   152	                    ReachViolation(
   153	                        ReachRule.R4_SIZE,
   154	                        control.tag,
   155	                        "is ${fmt(control.height)} dp tall, under the ${fmt(Reach.PRIMARY_MIN_HEIGHT_DP)} dp " +
   156	                            "primary height",
   157	                    ),
   158	                )
   159	            }
   160	            if (control.primary && control.rawLeft < Reach.EDGE_INSET_DP) {
   161	                add(
   162	                    ReachViolation(
   163	                        ReachRule.R5_EDGES,
   164	                        control.tag,
   165	                        "starts ${fmt(control.rawLeft)} dp from the left edge, inside the " +
   166	                            "${fmt(Reach.EDGE_INSET_DP)} dp inset",
   167	                    ),
   168	                )
   169	            }
   170	            val rightInset = windowWidthDp - control.rawRight
   171	            if (control.primary && rightInset < Reach.EDGE_INSET_DP) {
   172	                add(
   173	                    ReachViolation(
   174	                        ReachRule.R5_EDGES,
   175	                        control.tag,
   176	                        "starts ${fmt(rightInset)} dp from the right edge, inside the " +
   177	                            "${fmt(Reach.EDGE_INSET_DP)} dp inset",
   178	                    ),
   179	                )
   180	            }
   181	            // A target running past the window is clipped, so part of it cannot be pressed at all -
   182	            // which no amount of R1, size or horizontal-edge checking would reveal.
   183	            if (control.rawBottom > windowHeightDp) {
   184	                add(
   185	                    ReachViolation(
   186	                        ReachRule.R5_CONTAINMENT,
   187	                        control.tag,
   188	                        "ends at ${fmt(control.rawBottom)} dp, " +
   189	                            "${fmt(control.rawBottom - windowHeightDp)} dp past the bottom of the " +
   190	                            "${fmt(windowHeightDp)} dp window",
   191	                    ),
   192	                )
   193	            }
   194	            if (control.rawRight > windowWidthDp) {
   195	                add(
   196	                    ReachViolation(
   197	                        ReachRule.R5_CONTAINMENT,
   198	                        control.tag,
   199	                        "ends at ${fmt(control.rawRight)} dp, " +
   200	                            "${fmt(control.rawRight - windowWidthDp)} dp past the right edge",
   201	                    ),
   202	                )
   203	            }
   204	            // The left and top overruns matter for the same reason: the target is cut down to less than
   205	            // it claims to be, and on the left it sits inside the back-gesture strip as well.
   206	            if (control.rawLeft < 0f) {
