++                """
++                TopAppBar(
++                    title = { Text("Scores") },
++                    actions = { IconButton(onClick = {}) { Icon(Icons.Default.Refresh, null) } },
++                )
++                """.trimIndent(),
++            )
++
++        assertEquals(listOf(1), violations.map { it.line })
