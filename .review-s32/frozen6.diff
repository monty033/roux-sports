++++++                        .align(Alignment.BottomCenter)
++++++                        .padding(bottom = 16.dp)
++++++                        .size(width = 120.dp, height = 50.dp)
++++++                        .primaryControl("scores.shortRow"),
++++++                )
++++++            }
++++++        }
++++++
