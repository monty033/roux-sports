++++   174	    val axis: String
++++   175	    when {
++++   176	        verticalOverlap > 0f -> {
++++   177	            gap = maxOf(b.left - a.right, a.left - b.right)
++++   178	            axis = "horizontally"
++++   179	        }
++++   180	
++++   181	        horizontalOverlap > 0f -> {
++++   182	            gap = maxOf(b.top - a.bottom, a.top - b.bottom)
++++   183	            axis = "vertically"
++++   184	        }
++++   185	
++++   186	        else -> {
++++   187	            return null
++++   188	        }
++++   189	    }
++++   190	
++++   191	    // A negative gap means the targets overlap each other, which is worse than a small gap: the
++++   192	    // lower one cannot be tapped in the covered region at all.
++++   193	    if (gap < Reach.MIN_TARGET_GAP_DP) {
++++   194	        val (nearer, further) = if (a.left <= b.left) a to b else b to a
