   120	/**
   121	 * What a destination shows until its stage lands. The title is the destination's own name so a
   122	 * screenshot cannot be mistaken for the wrong tab, and the body says plainly that this is not the
   123	 * feature yet rather than showing an empty list that reads as "no games today".
   124	 */
   125	@Composable
   126	private fun PlaceholderScreen(
   127	    title: String,
   128	    body: String,
   129	    modifier: Modifier = Modifier,
   130	) {
   131	    Column(
   132	        modifier = modifier.fillMaxSize().padding(24.dp),
   133	        verticalArrangement = Arrangement.spacedBy(12.dp, Alignment.CenterVertically),
   134	        horizontalAlignment = Alignment.CenterHorizontally,
   135	    ) {
   136	        Text(text = title, style = MaterialTheme.typography.headlineMedium)
   137	        Text(
   138	            text = body,
   139	            style = MaterialTheme.typography.bodyMedium,
   140	            textAlign = TextAlign.Center,
   141	        )
   142	    }
   143	}
