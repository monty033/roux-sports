++++            if (control.primary && control.left < Reach.EDGE_INSET_DP) {
++++                add(
++++                    ReachViolation(
++++                        ReachRule.R5_EDGES,
++++                        control.tag,
++++                        "starts ${fmt(control.left)} dp from the left edge, inside the " +
++++                            "${fmt(Reach.EDGE_INSET_DP)} dp inset",
