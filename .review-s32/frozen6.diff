++++    return ReachViolation(
++++        ReachRule.R4_GAP,
++++        "${nearer.tag} / ${further.tag}",
++++        "$shape, under the ${fmt(Reach.MIN_TARGET_GAP_DP)} dp gap",
++++    )
++++}
++++
++++private fun isAncestor(
++++    candidate: String,
++++    of: String,
++++): Boolean = of.startsWith("$candidate/")
++++
++++private fun fmt(value: Float): String = "%.1f".format(value)
