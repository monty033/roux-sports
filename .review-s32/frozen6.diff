++++ * than what it looks like ("orangePill") - the point of the failure is to find the control again.
++++ */
++++fun Modifier.primaryControl(
++++    tag: String,
++++    frequent: Boolean = false,
++++): Modifier =
++++    semantics {
++++        primaryControlTag = tag
++++        isFrequentControl = frequent
