    29	/**
    30	 * S3.4: the shell has three destinations, it starts on Scores, and the bar survives the reach audit at
    31	 * the sizes and type scales that break layouts rather than the one size that happens to be on the desk.
    32	 */
    33	@RunWith(RobolectricTestRunner::class)
    34	@Config(sdk = [35], qualifiers = "w411dp-h923dp-420dpi")
    35	@GraphicsMode(GraphicsMode.Mode.NATIVE)
    36	class ShellTest {
    37	    @get:Rule
    38	    val rule = createComposeRule()
    39	
    40	    // A destination's name appears twice on screen - on its bar item and, once selected, as the
    41	    // placeholder heading. Bar assertions therefore match the selectable item, not the text alone.
    42	    private fun barItem(label: String) = rule.onNode(hasText(label) and isSelectable())
    43	
    44	    private val declaredPrimaries = listOf("nav.scores", "nav.standings", "nav.teams")
    45	
    46	    private fun launchShell(
    47	        dark: Boolean = false,
    48	        fontScale: Float = 1f,
    49	    ) {
    50	        rule.setContent {
    51	            RouxTheme(dark = dark) {
    52	                val base = LocalDensity.current
    53	                CompositionLocalProvider(
    54	                    LocalDensity provides Density(base.density, fontScale),
    55	                ) {
    56	                    RouxNavHost()
    57	                }
    58	            }
    59	        }
    60	    }
    61	
    62	    @Test
    63	    fun theThreeDestinationsAreOnTheBarAndScoresStartsSelected() {
    64	        launchShell()
    65	
    66	        barItem("Scores").assertExists()
    67	        barItem("Standings").assertExists()
    68	        barItem("Teams").assertExists()
    69	        barItem("Scores").assertIsSelected()
    70	    }
    71	
    72	    @Test
    73	    fun tappingStandingsShowsItsPlaceholder() {
    74	        launchShell()
    75	
    76	        // Both the bar label and the placeholder heading read "Standings", so the assertion is on the
    77	        // placeholder's own sentence - which exists only when the destination is actually shown.
    78	        rule.onNodeWithText("League standings will appear here.").assertDoesNotExist()
    79	        barItem("Standings").performClick()
    80	        rule.onNodeWithText("League standings will appear here.").assertExists()
    81	        barItem("Standings").assertIsSelected()
    82	    }
    83	
