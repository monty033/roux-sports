++        eachCall(code, token) { index, _ ->
++            violations +=
++                HiddenActionViolation(
++                    lineAt(code, index),
++                    "$token is a floating action button - R6 bans one at the top and this app has none; " +
++                        "if that is changing, change this rule in the same commit",
++                )
++        }
++    }
