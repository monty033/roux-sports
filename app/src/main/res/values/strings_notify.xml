<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Channel names and descriptions are user-visible in Android settings, so they say what arrives, not how it is produced. -->
    <string name="notify_channel_start">Game starts</string>
    <string name="notify_channel_start_description">When a game you follow begins.</string>
    <string name="notify_channel_goals">Goals</string>
    <string name="notify_channel_goals_description">When a game you follow has a new goal.</string>
    <string name="notify_channel_intermission">Intermissions</string>
    <string name="notify_channel_intermission_description">When a game you follow reaches an intermission.</string>
    <string name="notify_channel_final">Final scores</string>
    <string name="notify_channel_final_description">When a game you follow ends</string>

    <!-- Away abbreviation, away score, home score, home abbreviation: "TOR 2 – 1 MTL". -->
    <string name="notify_goal_title">%1$s %2$d – %3$d %4$s</string>
    <string name="notify_goal_text">Goal</string>
    <!-- Away, home: used when the feed has not given both scores, so the line states no number it does not have. -->
    <string name="notify_goal_unscored_title">%1$s at %2$s</string>
    <!-- Away short name, away score, home short name, home score: "Maple Leafs 3, Canadiens 2". -->
    <string name="notify_final_teams">%1$s %2$d, %3$s %4$d</string>
    <!-- The score line above. Only a kind the feed gave is worded; regulation and "not stated" are both plain "Final". -->
    <string name="notify_final_title">Final: %1$s</string>
    <string name="notify_final_ot_title">Final/OT: %1$s</string>
    <string name="notify_final_so_title">Final/SO: %1$s</string>
    <string name="notify_start_title">%1$s at %2$s</string>
    <string name="notify_start_text">The game has started.</string>
    <!-- Period ordinal, away abbreviation, away score, home score, home abbreviation: "1st Intermission · TOR 2 – 1 MTL". -->
    <string name="notify_intermission_title">%1$s Intermission · %2$s %3$d – %4$d %5$s</string>
</resources>
