+++    val needle = "$token("
+++    var index = code.indexOf(needle)
+++    while (index >= 0) {
+++        val before = code.getOrNull(index - 1) ?: ' '
+++        val partOfLongerName = before.isLetterOrDigit() || before == '_' || before == '$'
+++        if (!partOfLongerName) action(index)
+++        index = code.indexOf(needle, index + needle.length)
+++    }
