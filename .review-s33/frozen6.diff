++            val arguments = if (close > open) code.substring(open + 1, close) else ""
++            if (hasTopLevelActions(arguments) || hasPositionalActions(arguments)) {
++                violations +=
++                    HiddenActionViolation(
++                        lineAt(code, index),
++                        "$token carries actions = - the top bar holds a title only (R6)",
++                    )
++            }
++        }
++    }
