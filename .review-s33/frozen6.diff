+++
+++                        inner == '\'' -> {
+++                            out.append(' ')
+++                            index++
+++                            break
+++                        }
+++
+++                        inner == '\n' -> {
+++                            break
+++                        }
+++
+++                        else -> {
+++                            out.append(' ')
+++                            index++
+++                        }
+++                    }
+++                }
+++            }
+++
+++            else -> {
+++                out.append(char)
+++                index++
+++            }
+++        }
+++    }
+++    return out.toString()
