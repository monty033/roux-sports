    17	fun ComposeTestRule.assertPrimaryControlsReachable(vararg expectedPrimaryTags: String) {
    18	    val targets = reachTargets()
    19	    // The screen states its primary controls, and the audit insists the tree agrees. A count guard only
    20	    // catches losing every tag; a screen with two primary actions would still lose one of them silently,
    21	    // and that action would keep its size check while losing R1, R2 and the edge insets. An empty list is
    22	    // a positive statement that this screen has no primary controls.
    23	    val actual = targets.filter { it.primary }.map { it.tag }
    24	    val expected = expectedPrimaryTags.toList()
    25	
    26	    // A tag has to name exactly one control. Compared as sets, two controls sharing a tag would mask one
    27	    // of them losing its tag: the survivor keeps the set equal to the declaration while the other quietly
    28	    // drops out of R1 and R2. Duplicates are rejected outright instead of being collapsed.
    29	    fun duplicates(tags: List<String>): Set<String> =
    30	        tags
    31	            .groupingBy { it }
    32	            .eachCount()
    33	            .filterValues { it > 1 }
    34	            .keys
    35	
    36	    val duplicated = duplicates(actual) + duplicates(expected)
    37	    if (duplicated.isNotEmpty()) {
    38	        throw AssertionError(
    39	            "primary tags must be unique, but ${duplicated.sorted()} appear more than once - " +
    40	                "a shared tag hides one control losing it",
    41	        )
    42	    }
    43	
    44	    if (actual.sorted() != expected.sorted()) {
    45	        throw AssertionError(
    46	            "primary controls are ${actual.sorted()} but the screen declares ${expected.sorted()} - " +
    47	                "an untagged or reachTarget-declared action is outside R1, R2 and the edge rules",
    48	        )
    49	    }
    50	    val violations = reachViolations(targets)
    51	    if (violations.isNotEmpty()) {
    52	        throw AssertionError(
    53	            buildString {
    54	                append("${violations.size} reach violation(s) at ${density.density} density:\n")
    55	                violations.forEach { append("  - ${it.describe()}\n") }
    56	            }.trimEnd(),
    57	        )
    58	    }

