+++/** A single failed rule, with the measurement that failed it. */
+++data class ReachViolation(
+++    val rule: ReachRule,
+++    val tag: String,
+++    val detail: String,
+++) {
+++    fun describe(): String = "${rule.id}: '$tag' $detail"
+++}
