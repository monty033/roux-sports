+++            findHiddenActions(
+++                """
+++                CenterAlignedTopAppBar(
+++                    title = { Text("Standings") },
+++                )
+++                """.trimIndent(),
+++            )
+++
+++        assertEquals(emptyList<HiddenActionViolation>(), violations)
+++    }
+++
+++    @Test
