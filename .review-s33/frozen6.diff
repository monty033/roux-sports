+++        val source =
+++            """
+++            fun parseDropdownMenu() = Unit
+++            fun constructAlertDialogLater() = Unit
+++            """.trimIndent()
+++
+++        assertEquals(emptyList<HiddenActionViolation>(), findHiddenActions(source))
+++    }
