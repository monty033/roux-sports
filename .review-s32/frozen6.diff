++++
++++    /** R4: a primary control is bigger than the minimum - it is the thing a thumb must hit. */
++++    const val PRIMARY_MIN_HEIGHT_DP = 56f
++++
++++    /** R4: edge-to-edge clearance between adjacent targets. */
