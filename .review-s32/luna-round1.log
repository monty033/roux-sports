     8	/**
     9	 * The Compose-side half of the reach audit: read where the primary controls landed, then ask [Reach].
    10	 *
    11	 * This file is thin on purpose. Everything that decides pass or fail is in [findReachViolations] and is
    12	 * covered without Compose; the only thing this adds is a tree walk and a px-to-dp conversion. If a
    13	 * reach bug is ever about the *rule*, it is not in here.
    14	 */
    15	fun ComposeTestRule.assertPrimaryControlsReachable() {
    16	    val violations = reachViolations()
    17	    if (violations.isNotEmpty()) {
    18	        throw AssertionError(
    19	            buildString {
    20	                append("${violations.size} reach violation(s) at ${density.density} density:\n")
    21	                violations.forEach { append("  - ${it.describe()}\n") }
    22	            }.trimEnd(),
    23	        )
    24	    }
    25	}
    26	
    27	/**
    28	 * The tags the audit actually found, in tree order.
    29	 *
    30	 * A caller asserts these before judging violations. Without it, a composition that produced no tagged
    31	 * controls at all reads as "no violations" and a broken audit passes silently - which is how the gap
    32	 * test failed once during development, reporting "nothing was thrown" with no hint that it had seen
    33	 * nothing to throw about.
    34	 */
    35	fun ComposeTestRule.primaryControlTags(): List<String> {
    36	    val root = onRoot(useUnmergedTree = true).fetchSemanticsNode()
    37	    return root.primaryControls(density.density).map { it.tag }
    38	}
    39	
    40	/** Every way the current composition breaks R1-R5. Empty means reachable. */
    41	fun ComposeTestRule.reachViolations(): List<ReachViolation> {
    42	    val root = onRoot(useUnmergedTree = true).fetchSemanticsNode()
    43	    val scale = density.density
    44	    return findReachViolations(
    45	        controls = root.primaryControls(scale),
    46	        windowWidthDp = root.size.width / scale,
    47	        windowHeightDp = root.size.height / scale,
    48	    )
    49	}
    50	
    51	/**
    52	 * Tagged controls in this subtree, in dp.
    53	 *
    54	 * A tagged node is a leaf as far as this walk is concerned: if a container and something inside it
    55	 * were both tagged, counting both would report a gap violation against itself.
    56	 */
    57	private fun SemanticsNode.primaryControls(scale: Float): List<ControlPlacement> {
    58	    val found = mutableListOf<ControlPlacement>()
    59	
    60	    fun walk(node: SemanticsNode) {
    61	        val tag = node.config.getOrNull(PrimaryControlTag)
    62	        if (tag != null) {
    63	            val bounds = node.boundsInRoot
    64	            found +=
    65	                ControlPlacement(
    66	                    tag = tag,
    67	                    left = bounds.left / scale,
    68	                    top = bounds.top / scale,
    69	                    right = bounds.right / scale,
    70	                    bottom = bounds.bottom / scale,
    71	                    frequent = node.config.getOrNull(IsFrequentControl) ?: false,
    72	                )
    73	            return
    74	        }
    75	        node.children.forEach(::walk)
    76	    }
    77	    walk(this)
    78	    return found
    79	}
