    71	fun ComposeTestRule.reachViolations(): List<ReachViolation> = reachViolations(reachTargets())
    72	
    73	private fun ComposeTestRule.reachViolations(targets: List<ControlPlacement>): List<ReachViolation> {
    74	    val root = onRoot(useUnmergedTree = true).fetchSemanticsNode()
    75	    val scale = density.density
    76	    return findReachViolations(
    77	        controls = targets,
    78	        windowWidthDp = root.size.width / scale,
    79	        windowHeightDp = root.size.height / scale,
    80	    )
    81	}
    82	
    83	/**
    84	 * Every target in this subtree, in dp: anything clickable, plus anything explicitly tagged primary.
    85	 *
    86	 * Clickable nodes are collected because R4 applies to all targets, not only the tagged ones - an
    87	 * untagged 40 dp icon would otherwise escape the size rule entirely. Tagging adds R1, R2 and R5.
    88	 *
    89	 * The walk descends through tagged nodes rather than stopping at them: a tagged container with a
    90	 * clickable child is two targets, and the child must still meet the size rule. Ancestor/descendant
    91	 * pairs are excluded from the gap rule by [ControlPlacement.path], not by dropping them here.
    92	 */
    93	fun ComposeTestRule.reachTargets(): List<ControlPlacement> {
    94	    val root = onRoot(useUnmergedTree = true).fetchSemanticsNode()
    95	    val scale = density.density
    96	    val windowWidthDp = root.size.width / scale
    97	    val windowHeightDp = root.size.height / scale
    98	    val found = mutableListOf<ControlPlacement>()
    99	
   100	    fun walk(
   101	        node: SemanticsNode,
   102	        path: String,
   103	    ) {
   104	        // Two keys, deliberately not merged: primaryControl marks a control that R1, R2 and the edge
   105	        // insets also govern, while reachTarget only says "measure this". Collapsing them would subject
   106	        // a drag knob to the reach zone it is not in.
   107	        val primaryTag = node.config.getOrNull(PrimaryControlTag)
   108	        val declaredTarget = node.config.getOrNull(ReachTargetTag)
   109	        val tag = primaryTag ?: declaredTarget
   110	        // A target is anything a finger can act on: a click, or an adjustable control such as a slider,
   111	        // which carries SetProgress instead of OnClick and would otherwise be invisible to R4.
   112	        if (tag != null ||
   113	            node.config.contains(SemanticsActions.OnClick) ||
   114	            node.config.contains(SemanticsActions.SetProgress)
   115	        ) {
   116	            // Position and measured size, not boundsInRoot: boundsInRoot is clipped by parents, so a
   117	            // control running 17 dp past the bottom of the window reports a rectangle that stops exactly
   118	            // at the window edge, and looks like a smaller target that passes every rule. The overrun is
   119	            // only visible in the unclipped rectangle, which is position + size.
   120	            val left = node.positionInRoot.x / scale
   121	            val top = node.positionInRoot.y / scale
   122	            val right = left + node.size.width / scale
   123	            val bottom = top + node.size.height / scale
   124	            // boundsInRoot is already clipped by every ancestor as well as the window, which is exactly
   125	            // the area a finger can reach. Intersecting position+size with the window instead would miss
   126	            // a control inside a nested scroll viewport that shows only part of it.
   127	            val clipped = node.boundsInRoot
   128	            val visibleLeft = (clipped.left / scale).coerceIn(0f, windowWidthDp)
   129	            val visibleTop = (clipped.top / scale).coerceIn(0f, windowHeightDp)
   130	            val visibleRight = (clipped.right / scale).coerceIn(visibleLeft, windowWidthDp)
   131	            val visibleBottom = (clipped.bottom / scale).coerceIn(visibleTop, windowHeightDp)
   132	            found +=
   133	                ControlPlacement(
   134	                    tag = tag ?: describe(node, left, top),
   135	                    rawLeft = left,
   136	                    rawTop = top,
   137	                    rawRight = right,
   138	                    rawBottom = bottom,
   139	                    visibleLeft = visibleLeft,
   140	                    visibleTop = visibleTop,
   141	                    visibleRight = visibleRight,
   142	                    visibleBottom = visibleBottom,
   143	                    primary = primaryTag != null,
   144	                    frequent = node.config.getOrNull(IsFrequentControl) ?: false,
   145	                    path = path,
   146	                )
   147	        }
   148	        node.children.forEachIndexed { index, child -> walk(child, if (path.isEmpty()) "$index" else "$path/$index") }
   149	    }
   150	    walk(root, "")
   151	    return found
   152	}
   153	
   154	/** A name for an untagged target, so a failure can still be found on screen. */
   155	private fun describe(
   156	    node: SemanticsNode,
   157	    leftDp: Float,
   158	    topDp: Float,
   159	): String {
   160	    val testTag = node.config.getOrNull(SemanticsProperties.TestTag)
   161	    if (testTag != null) return testTag
   162	    val label =
   163	        node.config.getOrNull(SemanticsProperties.ContentDescription)?.firstOrNull()
   164	            ?: node.config
   165	                .getOrNull(SemanticsProperties.Text)
   166	                ?.firstOrNull()
   167	                ?.text
   168	    return label?.let { "unlabelled '$it'" }
   169	        ?: "unlabelled target at ${leftDp.toInt()},${topDp.toInt()} dp"
   170	}
