+++                violations +=
+++                    HiddenActionViolation(
+++                        lineAt(code, index),
+++                        "$call carries actions = - the top bar holds a title only (R6)",
+++                    )
+++            }
+++            index = code.indexOf(call, index + call.length)
+++        }
+++    }
+++
+++    return violations.sortedBy { it.line }
+++}
+++
+++private fun lineAt(
