    92	/**
    93	 * Every target in this subtree, in dp: anything clickable, plus anything explicitly tagged primary.
    94	 *
    95	 * Clickable nodes are collected because R4 applies to all targets, not only the tagged ones - an
    96	 * untagged 40 dp icon would otherwise escape the size rule entirely. Tagging adds R1, R2 and R5.
    97	 *
    98	 * The walk descends through tagged nodes rather than stopping at them: a tagged container with a
    99	 * clickable child is two targets, and the child must still meet the size rule. Ancestor/descendant
   100	 * pairs are excluded from the gap rule by [ControlPlacement.path], not by dropping them here.
   101	 */
   102	fun ComposeTestRule.reachTargets(): List<ControlPlacement> {
   103	    val root = onRoot(useUnmergedTree = true).fetchSemanticsNode()
   104	    val scale = density.density
   105	    val windowWidthDp = root.size.width / scale
   106	    val windowHeightDp = root.size.height / scale
   107	    val found = mutableListOf<ControlPlacement>()
   108	
   109	    // Every semantics action that means "a person operates this", decided once rather than one action per
   110	    // review round. Each entry earned its place by being a real control that carries no OnClick: a slider
   111	    // exposes SetProgress, and a text field can expose SetText and nothing else, so a 40 dp field used to
   112	    // vanish from the audit while it passed.
   113	    //
   114	    // Deliberately absent: ScrollBy and its relatives, because a scrollable region is a container rather
   115	    // than a target and including it would flag every list. Custom actions added through
   116	    // semantics { customActions = ... } cannot be read reliably here; such a control declares itself with
   117	    // Modifier.reachTarget(tag).
   118	    val actions =
   119	        listOf(
   120	            SemanticsActions.OnClick,
   121	            SemanticsActions.OnLongClick,
   122	            SemanticsActions.SetProgress,
   123	            SemanticsActions.SetText,
   124	            SemanticsActions.SetSelection,
   125	            SemanticsActions.Expand,
   126	            SemanticsActions.Collapse,
   127	            SemanticsActions.Dismiss,
   128	        )
