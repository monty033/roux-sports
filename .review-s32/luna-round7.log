++   158	/**
++   159	 * R4's clearance rule, for two targets that sit side by side or stacked.
++   160	 *
++   161	 * Only pairs that actually neighbour each other are judged: two controls on different rows of a list
++   162	 * are separated by the row height, not by a gap their author chose, so checking every pair would
++   163	 * invent failures. A pair counts as horizontal neighbours when their vertical spans overlap, and as
++   164	 * vertical neighbours when their horizontal spans do.
++   165	 */
++   166	private fun findGapViolation(
++   167	    a: ControlPlacement,
++   168	    b: ControlPlacement,
++   169	): ReachViolation? {
++   170	    val verticalOverlap = minOf(a.bottom, b.bottom) - maxOf(a.top, b.top)
++   171	    val horizontalOverlap = minOf(a.right, b.right) - maxOf(a.left, b.left)
++   172	
++   173	    val gap: Float
++   174	    val axis: String
++   175	    when {
++   176	        verticalOverlap > 0f -> {
++   177	            gap = maxOf(b.left - a.right, a.left - b.right)
++   178	            axis = "horizontally"
++   179	        }
++   180	
++   181	        horizontalOverlap > 0f -> {
++   182	            gap = maxOf(b.top - a.bottom, a.top - b.bottom)
++   183	            axis = "vertically"
++   184	        }
++   185	
++   186	        else -> {
++   187	            return null
++   188	        }
++   189	    }
++   190	
++   191	    // A negative gap means the targets overlap each other, which is worse than a small gap: the
++   192	    // lower one cannot be tapped in the covered region at all.
++   193	    if (gap < Reach.MIN_TARGET_GAP_DP) {
++   194	        val (nearer, further) = if (a.left <= b.left) a to b else b to a
++   195	        return ReachViolation(
++   196	            ReachRule.R4_GAP,
++   197	            "${nearer.tag} / ${further.tag}",
++   198	            "are ${fmt(gap)} dp apart $axis, under the ${fmt(Reach.MIN_TARGET_GAP_DP)} dp gap",
++   199	        )
++   200	    }
++   201	    return null
++   202	}
