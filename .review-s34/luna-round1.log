    61	@Composable
    62	fun RouxNavHost(modifier: Modifier = Modifier) {
    63	    val navController = rememberNavController()
    64	    val backStackEntry by navController.currentBackStackEntryAsState()
    65	    val currentRoute = backStackEntry?.destination?.route
    66	
    67	    Scaffold(
    68	        modifier = modifier.fillMaxSize(),
    69	        bottomBar = {
    70	            NavigationBar {
    71	                // R5 keeps primary controls 16 dp clear of the screen edges, where the back gesture
    72	                // lives. A stock NavigationBar puts its outer items flush to the edges, so the bar's
    73	                // own background stays full-bleed and the items are pushed inside it by spacers -
    74	                // padding the bar itself would inset its background and leave a strip of page showing.
    75	                Spacer(Modifier.width(Reach.EDGE_INSET_DP.dp))
    76	                TopLevelDestination.entries.forEach { destination ->
    77	                    val label = stringResource(destination.label)
    78	                    NavigationBarItem(
    79	                        // Primary navigation is the most-used control on every screen, so it is
    80	                        // tagged frequent: R2 holds it to the thumb-zone ceiling, not the looser one.
    81	                        modifier = Modifier.primaryControl(destination.tag, frequent = true),
    82	                        selected = currentRoute == destination.route,
    83	                        onClick = {
    84	                            if (currentRoute != destination.route) {
    85	                                navController.navigate(destination.route) {
    86	                                    // One entry per destination, and back from any tab returns to the
    87	                                    // start destination rather than replaying a tab history.
    88	                                    popUpTo(navController.graph.findStartDestination().id) {
    89	                                        saveState = true
    90	                                    }
    91	                                    launchSingleTop = true
    92	                                    restoreState = true
    93	                                }
    94	                            }
    95	                        },
    96	                        icon = {
    97	                            Icon(imageVector = destination.icon(), contentDescription = null)
    98	                        },
    99	                        label = { Text(label) },
   100	                    )
   101	                }
   102	                Spacer(Modifier.width(Reach.EDGE_INSET_DP.dp))
   103	            }
   104	        },
   105	    ) { innerPadding ->
   106	        NavHost(
   107	            navController = navController,
   108	            startDestination = TopLevelDestination.Scores.route,
   109	            modifier = Modifier.padding(innerPadding),
   110	        ) {
   111	            TopLevelDestination.entries.forEach { destination ->
   112	                composable(destination.route) {
   113	                    PlaceholderScreen(title = stringResource(destination.label), body = stringResource(destination.placeholder))
   114	                }
   115	            }
   116	        }
   117	    }
   118	}
