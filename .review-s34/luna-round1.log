   130	    fun walk(
   131	        node: SemanticsNode,
   132	        path: String,
   133	    ) {
   134	        // Two keys, deliberately not merged: primaryControl marks a control that R1, R2 and the edge
   135	        // insets also govern, while reachTarget only says "measure this". Collapsing them would subject
   136	        // a drag knob to the reach zone it is not in.
   137	        val primaryTag = node.config.getOrNull(PrimaryControlTag)
   138	        val declaredTarget = node.config.getOrNull(ReachTargetTag)
   139	        val tag = primaryTag ?: declaredTarget
   140	        if (tag != null || actions.any { node.config.contains(it) }) {
   141	            // Position and measured size, not boundsInRoot: boundsInRoot is clipped by parents, so a
   142	            // control running 17 dp past the bottom of the window reports a rectangle that stops exactly
   143	            // at the window edge, and looks like a smaller target that passes every rule. The overrun is
   144	            // only visible in the unclipped rectangle, which is position + size.
   145	            val left = node.positionInRoot.x / scale
   146	            val top = node.positionInRoot.y / scale
   147	            val right = left + node.size.width / scale
   148	            val bottom = top + node.size.height / scale
   149	            // boundsInRoot is already clipped by every ancestor as well as the window, which is exactly
   150	            // the area a finger can reach. Intersecting position+size with the window instead would miss
   151	            // a control inside a nested scroll viewport that shows only part of it.
   152	            val clipped = node.boundsInRoot
   153	            val visibleLeft = (clipped.left / scale).coerceIn(0f, windowWidthDp)
   154	            val visibleTop = (clipped.top / scale).coerceIn(0f, windowHeightDp)
   155	            val visibleRight = (clipped.right / scale).coerceIn(visibleLeft, windowWidthDp)
   156	            val visibleBottom = (clipped.bottom / scale).coerceIn(visibleTop, windowHeightDp)
   157	            found +=
   158	                ControlPlacement(
   159	                    tag = tag ?: describe(node, left, top),
   160	                    rawLeft = left,
   161	                    rawTop = top,
   162	                    rawRight = right,
   163	                    rawBottom = bottom,
   164	                    visibleLeft = visibleLeft,
   165	                    visibleTop = visibleTop,
   166	                    visibleRight = visibleRight,
   167	                    visibleBottom = visibleBottom,
   168	                    primary = primaryTag != null,
   169	                    frequent = node.config.getOrNull(IsFrequentControl) ?: false,
   170	                    path = path,
   171	                )
   172	        }
   173	        node.children.forEachIndexed { index, child -> walk(child, if (path.isEmpty()) "$index" else "$path/$index") }
   174	    }
   175	    walk(root, "")
   176	    return found
   177	}
