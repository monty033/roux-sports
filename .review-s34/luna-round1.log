    73	 * A caller asserts these before judging violations. Without it, a composition that produced no tagged
    74	 * controls reads as "no violations" and a broken audit passes silently - which is how the gap test
    75	 * failed once during development, reporting "nothing was thrown" with no hint that it had seen nothing.
    76	 */
    77	fun ComposeTestRule.primaryControlTags(): List<String> = reachTargets().filter { it.primary }.map { it.tag }
