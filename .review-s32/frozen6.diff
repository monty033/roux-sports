+++++        verticalOverlap > 0f -> {
+++++            gap = maxOf(b.left - a.right, a.left - b.right)
+++++            axis = "horizontally"
+++++        }
+++++
+++++        horizontalOverlap > 0f -> {
+++++            gap = maxOf(b.top - a.bottom, a.top - b.bottom)
+++++            axis = "vertically"
+++++        }
+++++
+++++        else -> {
+++++            return null
+++++        }
+++++    }
