+++    // original name.
+++    val topBarTokens = topBarNames + aliases.filterValues { it in topBarNames }.keys
+++    val bannedTokens =
+++        bannedCalls +
+++            aliases
+++                .filterValues { it in bannedCalls }
+++                .mapValues { (_, canonical) -> bannedCalls.getValue(canonical) }
