++                tag = "edge.belowWindow",
++                rawLeft = 16f,
++                rawTop = 923f,
++                rawRight = 136f,
++                rawBottom = 979f,
++                visibleLeft = 16f,
++                visibleTop = 923f,
++                visibleRight = 136f,
++                visibleBottom = 923f,
++                primary = true,
++                path = "1",
++            )
++
++        val violations = findReachViolations(listOf(visible, belowWindow), windowWidthDp = 411f, windowHeightDp = 923f)
