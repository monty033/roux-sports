+++            char == '"' -> {
+++                out.append(' ')
+++                index++
+++                while (index < source.length) {
+++                    val inner = source[index]
+++                    when {
+++                        inner == '\\' -> {
+++                            out.append("  ")
+++                            index += 2
+++                        }
+++
+++                        inner == '"' -> {
+++                            out.append(' ')
+++                            index++
+++                            break
+++                        }
+++
+++                        else -> {
+++                            out.append(if (inner == '\n') '\n' else ' ')
+++                            index++
+++                        }
+++                    }
+++                }
+++            }
+++
+++            char == '\'' -> {
+++                // A character literal, including the escaped ones: '"', '\'', '\n'.
+++                out.append(' ')
+++                index++
+++                while (index < source.length) {
+++                    val inner = source[index]
+++                    when {
+++                        inner == '\\' -> {
+++                            out.append("  ")
+++                            index += 2
+++                        }
+++
+++                        inner == '\'' -> {
+++                            out.append(' ')
+++                            index++
+++                            break
+++                        }
+++
+++                        inner == '\n' -> {
+++                            break
+++                        }
+++
+++                        else -> {
+++                            out.append(' ')
+++                            index++
+++                        }
+++                    }
+++                }
+++            }
+++
+++            else -> {
+++                out.append(char)
+++                index++
+++            }
+++        }
+++    }
+++    return out.toString()
+++}
