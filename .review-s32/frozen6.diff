+++                    ReachViolation(
+++                        ReachRule.R5_EDGES,
+++                        control.tag,
+++                        "starts ${fmt(rightInset)} dp from the right edge, inside the " +
+++                            "${fmt(Reach.EDGE_INSET_DP)} dp inset",
+++                    ),
+++                )
