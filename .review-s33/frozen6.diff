+++                }
+++            }
+++
+++            char == '/' && source.getOrNull(index + 1) == '*' -> {
+++                out.append("  ")
+++                index += 2
+++                var depth = 1
+++                while (index < source.length && depth > 0) {
+++                    when {
+++                        source[index] == '/' && source.getOrNull(index + 1) == '*' -> {
+++                            out.append("  ")
+++                            index += 2
+++                            depth++
+++                        }
+++
+++                        source[index] == '*' && source.getOrNull(index + 1) == '/' -> {
+++                            out.append("  ")
+++                            index += 2
+++                            depth--
+++                        }
+++
+++                        else -> {
+++                            out.append(if (source[index] == '\n') '\n' else ' ')
+++                            index++
+++                        }
+++                    }
+++                }
+++            }
+++
+++            source.startsWith("\"\"\"", index) -> {
+++                out.append("   ")
+++                index += 3
+++                while (index < source.length) {
+++                    if (source.startsWith("\"\"\"", index)) {
+++                        out.append("   ")
+++                        index += 3
+++                        break
+++                    }
+++                    out.append(if (source[index] == '\n') '\n' else ' ')
+++                    index++
+++                }
+++            }
+++
+++            char == '"' -> {
+++                out.append(' ')
+++                index++
+++                while (index < source.length) {
+++                    val inner = source[index]
+++                    when {
+++                        inner == '\\' -> {
+++                            out.append("  ")
+++                            index += 2
+++                        }
+++
+++                        inner == '"' -> {
+++                            out.append(' ')
+++                            index++
+++                            break
+++                        }
+++
+++                        else -> {
+++                            out.append(if (inner == '\n') '\n' else ' ')
+++                            index++
+++                        }
+++                    }
+++                }
+++            }
+++
+++            char == '\'' -> {
+++                // A character literal, including the escaped ones: '"', '\'', '\n'.
+++                out.append(' ')
+++                index++
+++                while (index < source.length) {
+++                    val inner = source[index]
+++                    when {
+++                        inner == '\\' -> {
+++                            out.append("  ")
+++                            index += 2
+++                        }
+++
+++                        inner == '\'' -> {
+++                            out.append(' ')
+++                            index++
+++                            break
+++                        }
+++
+++                        inner == '\n' -> {
+++                            break
+++                        }
+++
+++                        else -> {
+++                            out.append(' ')
+++                            index++
+++                        }
+++                    }
+++                }
+++            }
+++
+++            else -> {
