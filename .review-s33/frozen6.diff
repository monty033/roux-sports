+++++                        }
+++++
+++++                        else -> {
+++++                            out.append(if (inner == '\n') '\n' else ' ')
+++++                            index++
+++++                        }
+++++                    }
+++++                }
+++++            }
+++++
+++++            else -> {
+++++                out.append(char)
+++++                index++
+++++            }
+++++        }
+++++    }
