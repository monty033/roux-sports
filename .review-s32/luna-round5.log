+    @Test
+    fun aTagWithTheWrongNameIsCaughtEvenWhenTheCountAgrees() {
+        rule.setContent {
+            Box(Modifier.fillMaxSize()) {
+                Row(
+                    Modifier
+                        .align(Alignment.BottomStart)
+                        .padding(start = 16.dp, bottom = 16.dp),
