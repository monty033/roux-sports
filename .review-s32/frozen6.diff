+++++            ReachRule.R4_GAP,
+++++            "${nearer.tag} / ${further.tag}",
+++++            "are ${fmt(gap)} dp apart $axis, under the ${fmt(Reach.MIN_TARGET_GAP_DP)} dp gap",
+++++        )
+++++    }
+++++    return null
