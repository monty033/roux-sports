    65	 * controls reads as "no violations" and a broken audit passes silently - which is how the gap test
    66	 * failed once during development, reporting "nothing was thrown" with no hint that it had seen nothing.
    67	 */
    68	fun ComposeTestRule.primaryControlTags(): List<String> = reachTargets().filter { it.primary }.map { it.tag }
