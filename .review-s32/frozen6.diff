++++    @Test
++++    fun aClickableInsideATaggedParentIsJudgedButNotTreatedAsOverlapping() {
++++        rule.setContent {
++++            Box(Modifier.fillMaxSize()) {
++++                Box(
++++                    Modifier
++++                        .align(Alignment.BottomCenter)
++++                        .padding(bottom = 16.dp)
