++++            if (control.right > windowWidthDp) {
++++                add(
++++                    ReachViolation(
++++                        ReachRule.R5_CONTAINMENT,
++++                        control.tag,
++++                        "ends at ${fmt(control.right)} dp, " +
++++                            "${fmt(control.right - windowWidthDp)} dp past the right edge",
++++                    ),
++++                )
