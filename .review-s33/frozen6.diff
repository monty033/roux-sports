+++    val call = Regex("(?<![\\w$])" + Regex.escape(token) + """\s*\(""")
+++    call.findAll(code).forEach { match ->
+++        val open = code.indexOf('(', match.range.first)
+++        if (open >= 0) action(match.range.first, open)
+++    }
+++}
