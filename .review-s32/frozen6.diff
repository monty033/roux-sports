++++                        .padding(bottom = 16.dp)
++++                        .size(width = 200.dp, height = 56.dp)
++++                        .primaryControl("scores.refresh"),
++++                )
++++            }
++++        }
++++
++++        assertSaw("scores.refresh")
++++        rule.assertPrimaryControlsReachable()
