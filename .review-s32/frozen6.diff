+++data class ControlPlacement(
+++    val tag: String,
+++    val left: Float,
+++    val top: Float,
+++    val right: Float,
+++    val bottom: Float,
+++    val primary: Boolean = false,
+++    val frequent: Boolean = false,
+++    val path: String = "",
