+++        val primaryTopLimit = windowHeightDp * Reach.PRIMARY_TOP_MAX_FRACTION
+++        val frequentTopLimit = windowHeightDp * Reach.FREQUENT_TOP_MAX_FRACTION
+++
+++        for (control in controls) {
