+++++        val source =
+++++            """
+++++            FloatingActionButton(modifier = Modifier.align(Alignment.BottomEnd), onClick = {}) { Text("+") }
+++++            """.trimIndent()
+++++
+++++        assertEquals(emptyList<HiddenActionViolation>(), findHiddenActions(source))
+++++    }
+++++
