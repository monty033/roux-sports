   208	                    ReachViolation(
   209	                        ReachRule.R5_CONTAINMENT,
   210	                        control.tag,
   211	                        "starts at ${fmt(control.rawLeft)} dp, ${fmt(-control.rawLeft)} dp past the left edge",
   212	                    ),
   213	                )
   214	            }
   215	            if (control.rawTop < 0f) {
   216	                add(
   217	                    ReachViolation(
   218	                        ReachRule.R5_CONTAINMENT,
   219	                        control.tag,
   220	                        "starts at ${fmt(control.rawTop)} dp, ${fmt(-control.rawTop)} dp above the top edge",
   221	                    ),
   222	                )
   223	            }
