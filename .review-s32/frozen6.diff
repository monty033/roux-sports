++++/** Which rule a violation belongs to, so a failure can be read without decoding prose. */
++++enum class ReachRule(
++++    val id: String,
++++) {
++++    R1("R1 reach zone"),
++++    R2("R2 frequent controls"),
++++    R4_SIZE("R4 target size"),
++++    R4_GAP("R4 target gap"),
++++    R5_EDGES("R5 edges"),
++++    R5_CONTAINMENT("R5 containment"),
++++}
