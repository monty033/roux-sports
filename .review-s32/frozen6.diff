+++++    @Test
+++++    fun aFrequentControlAtSixtyPercentHeightFailsR2ButNotR1() {
+++++        rule.setContent {
+++++            Box(Modifier.fillMaxSize()) {
+++++                Box(
+++++                    Modifier
+++++                        .align(Alignment.TopStart)
