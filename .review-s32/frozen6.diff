+++++    }
+++++
+++++    @Test
+++++    fun aControlInTheTopHalfFailsAndTheMessageNamesItsTag() {
+++++        rule.setContent {
+++++            Box(Modifier.fillMaxSize()) {
+++++                Box(
+++++                    Modifier
+++++                        .padding(start = 16.dp, top = 16.dp)
+++++                        .size(width = 200.dp, height = 56.dp)
+++++                        .primaryControl("scores.title"),
+++++                )
+++++            }
+++++        }
