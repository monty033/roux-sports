    82	private fun ComposeTestRule.reachViolations(targets: List<ControlPlacement>): List<ReachViolation> {
    83	    val root = onRoot(useUnmergedTree = true).fetchSemanticsNode()
    84	    val scale = density.density
    85	    return findReachViolations(
    86	        controls = targets,
    87	        windowWidthDp = root.size.width / scale,
    88	        windowHeightDp = root.size.height / scale,
    89	    )
    90	}
