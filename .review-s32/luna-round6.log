   237	/**
   238	 * R4's clearance rule, for two targets close enough on both axes to be neighbours.
   239	 *
   240	 * Distance is measured per axis and a pair is judged only when **both** axes are under the minimum:
   241	 * two targets 4 dp apart vertically but 300 dp apart horizontally are not neighbours, and inventing a
   242	 * failure for them would make the audit unusable. Diagonal neighbours are therefore covered - two
   243	 * targets 4 dp apart on each axis have a 4 dp gap by this measure, not the 5.7 dp corner clearance a
   244	 * straight-line reading would give.
   245	 *
   246	 * An ancestor and its descendant are skipped: their rectangles overlap by construction and both are
   247	 * still reported separately if they break a size rule.
   248	 */
   249	private fun findGapViolation(
   250	    a: ControlPlacement,
   251	    b: ControlPlacement,
   252	): ReachViolation? {
   253	    if (a.path.isNotEmpty() && b.path.isNotEmpty() && (isAncestor(a.path, b.path) || isAncestor(b.path, a.path))) {
   254	        return null
   255	    }
   256	
   257	    val gapX = maxOf(b.visibleLeft - a.visibleRight, a.visibleLeft - b.visibleRight)
   258	    val gapY = maxOf(b.visibleTop - a.visibleBottom, a.visibleTop - b.visibleBottom)
   259	    val worst = maxOf(gapX, gapY)
   260	    if (worst >= Reach.MIN_TARGET_GAP_DP) return null
   261	
   262	    // Negative means the rectangles overlap: the lower target cannot be pressed where it is covered.
   263	    val shape =
   264	        if (worst < 0f) {
   265	            "overlap by ${fmt(-worst)} dp"
   266	        } else {
   267	            "are ${fmt(gapX)} dp apart horizontally and ${fmt(gapY)} dp vertically"
   268	        }
   269	    val (nearer, further) = if (a.visibleLeft <= b.visibleLeft) a to b else b to a
   270	    return ReachViolation(
   271	        ReachRule.R4_GAP,
   272	        "${nearer.tag} / ${further.tag}",
   273	        "$shape, under the ${fmt(Reach.MIN_TARGET_GAP_DP)} dp gap",
   274	    )
   275	}
   276	
   277	private fun isAncestor(
   278	    candidate: String,
   279	    of: String,
   280	): Boolean =
   281	    if (candidate.isEmpty()) {
   282	        // Defensive: the fetched semantics root is an ancestor of every node. Current traversal does not
   283	        // collect the root itself, so this branch is unreachable today and is kept only so a future
   284	        // collector that does include it cannot report a root click as overlapping its children.
   285	        of.isNotEmpty()
   286	    } else {
   287	        of.startsWith("$candidate/")
   288	    }
