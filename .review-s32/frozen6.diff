+++        throw AssertionError(
+++            buildString {
+++                append("${violations.size} reach violation(s) at ${density.density} density:\n")
+++                violations.forEach { append("  - ${it.describe()}\n") }
+++            }.trimEnd(),
+++        )
+++    }
+++}
