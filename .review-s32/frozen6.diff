++++                        control.tag,
++++                        "is ${fmt(control.height)} dp tall, under the ${fmt(Reach.PRIMARY_MIN_HEIGHT_DP)} dp " +
++++                            "primary height",
++++                    ),
++++                )
++++            }
++++            if (control.primary && control.left < Reach.EDGE_INSET_DP) {
++++                add(
++++                    ReachViolation(
++++                        ReachRule.R5_EDGES,
++++                        control.tag,
++++                        "starts ${fmt(control.left)} dp from the left edge, inside the " +
