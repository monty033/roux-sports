+++++        val message = failure().message.orEmpty()
+++++        assertTrue("R1 should be cited, got: $message", message.contains("R1"))
+++++        assertTrue("the failing control should be named, got: $message", message.contains("scores.title"))
+++++    }
+++++
+++++    @Test
