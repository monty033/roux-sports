++++        val char = source[index]
++++        when {
++++            char == '/' && source.getOrNull(index + 1) == '/' -> {
++++                while (index < source.length && source[index] != '\n') {
++++                    out.append(' ')
++++                    index++
++++                }
++++            }
++++
