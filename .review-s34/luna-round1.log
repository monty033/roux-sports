     8	/**
     9	 * The one-handed reach rules (A8, R1-R5), as numbers and as a pure check.
    10	 *
    11	 * The rules are fractions of window height rather than absolute offsets, so they hold on a 6.1" phone
    12	 * and on the Pixel 9 alike. Nothing here measures anything: a caller hands in where each target
    13	 * actually landed, and this decides pass or fail. That keeps the policy testable without Compose and
    14	 * keeps the Compose-side reader thin enough to be obvious.
    15	 *
    16	 * R4 is not conditional on tagging. Tagging marks a control as primary, which *additionally* subjects
    17	 * it to R1, R2 and R5; it is not the price of admission to the size and gap rules. An untagged 40 dp
    18	 * icon is still a 40 dp target, so a screen with no primary controls whatsoever can still fail R4.
    19	 */
    20	object Reach {
    21	    /** R1: a primary control's top edge must be at or below this fraction of window height. */
    22	    const val PRIMARY_TOP_MAX_FRACTION = 0.50f
    23	
    24	    /** R2: a frequent control's top edge must be at or below this fraction of window height. */
    25	    const val FREQUENT_TOP_MAX_FRACTION = 0.70f
    26	
    27	    /** R4: no target smaller than this in either dimension. */
    28	    const val MIN_TARGET_DP = 48f
    29	
    30	    /** R4: a primary control is bigger than the minimum - it is the thing a thumb must hit. */
    31	    const val PRIMARY_MIN_HEIGHT_DP = 56f
    32	
    33	    /** R4: edge-to-edge clearance between adjacent targets. */
    34	    const val MIN_TARGET_GAP_DP = 8f
    35	
    36	    /** R5: no primary control this close to the left or right edge (thumb arc, back gesture). */
    37	    const val EDGE_INSET_DP = 16f
    38	}
    39	
    40	/** Which rule a violation belongs to, so a failure can be read without decoding prose. */
    41	enum class ReachRule(
    42	    val id: String,
    43	) {
    44	    R1("R1 reach zone"),
    45	    R2("R2 frequent controls"),
    46	    R4_SIZE("R4 target size"),
    47	    R4_GAP("R4 target gap"),
    48	    R5_EDGES("R5 edges"),
    49	    R5_CONTAINMENT("R5 containment"),
    50	}
    51	
    52	/**
    53	 * Where one target ended up, in dp.
    54	 *
    55	 * Two rectangles, because they answer different questions. The raw rectangle is where the control was
    56	 * laid out; the visible one is the part inside the window. Size and clearance are judged on what a thumb
    57	 * can actually hit, so a 56 dp button hanging 20 dp off the left edge is a 36 dp target however large
    58	 * its layout size is. Position rules (R1, R2, the edge insets) use the raw rectangle, because a control
    59	 * that starts above the reach line does not become reachable by being clipped.
    60	 *
    61	 * [path] is the node's position in the semantics tree ("0/2/1"), so an ancestor and the thing inside it
    62	 * are not reported as overlapping: a clickable row with a clickable star is two legitimate targets.
    63	 */
    64	data class ControlPlacement(
    65	    val tag: String,
    66	    val rawLeft: Float,
    67	    val rawTop: Float,
    68	    val rawRight: Float,
    69	    val rawBottom: Float,
    70	    val visibleLeft: Float,
    71	    val visibleTop: Float,
    72	    val visibleRight: Float,
    73	    val visibleBottom: Float,
    74	    val primary: Boolean = false,
    75	    val frequent: Boolean = false,
    76	    val path: String = "",
    77	) {
    78	    /** What a thumb can actually press: the part of the target inside the window. */
    79	    val width: Float get() = visibleRight - visibleLeft
    80	    val height: Float get() = visibleBottom - visibleTop
    81	
    82	    val isVisible: Boolean get() = width > 0f && height > 0f
    83	}
