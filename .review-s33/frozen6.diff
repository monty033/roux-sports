++++                out.append("  ")
++++                index += 2
++++                while (index < source.length) {
++++                    if (source[index] == '*' && source.getOrNull(index + 1) == '/') {
++++                        out.append("  ")
++++                        index += 2
++++                        break
++++                    }
++++                    out.append(if (source[index] == '\n') '\n' else ' ')
++++                    index++
++++                }
++++            }
++++
++++            source.startsWith("\"\"\"", index) -> {
++++                out.append("   ")
++++                index += 3
++++                while (index < source.length) {
++++                    if (source.startsWith("\"\"\"", index)) {
++++                        out.append("   ")
++++                        index += 3
++++                        break
++++                    }
++++                    out.append(if (source[index] == '\n') '\n' else ' ')
++++                    index++
++++                }
++++            }
++++
++++            char == '"' -> {
++++                out.append(' ')
++++                index++
++++                while (index < source.length) {
++++                    val inner = source[index]
++++                    when {
++++                        inner == '\\' -> {
++++                            out.append("  ")
++++                            index += 2
++++                        }
++++
++++                        inner == '"' -> {
++++                            out.append(' ')
++++                            index++
++++                            break
++++                        }
++++
++++                        else -> {
++++                            out.append(if (inner == '\n') '\n' else ' ')
++++                            index++
++++                        }
++++                    }
++++                }
++++            }
++++
++++            else -> {
++++                out.append(char)
++++                index++
++++            }
++++        }
++++    }
