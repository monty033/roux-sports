+++    val root = onRoot(useUnmergedTree = true).fetchSemanticsNode()
+++    val scale = density.density
+++    return findReachViolations(
+++        controls = targets,
+++        windowWidthDp = root.size.width / scale,
+++        windowHeightDp = root.size.height / scale,
+++    )
+++}
